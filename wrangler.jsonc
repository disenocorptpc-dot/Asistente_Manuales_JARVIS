{
  // Worker del VISOR: assets estáticos + LA ruta de publicación del equipo.
  // PUT /api/publicar (src/worker.js) convierte un GLB en un commit atómico
  // del repo JARVIS-Modelos vía la API de GitHub — los compañeros publican
  // desde el addon sin git, sin clones y sin tocar este repo. Secrets del
  // worker: PUBLICAR_TOKEN (el del equipo) y GITHUB_PAT_MODELOS (fine-grained,
  // sólo Contents de JARVIS-Modelos).
  // ⚠ Los secrets se montan con `wrangler secret put` y se ha visto que un
  // deploy de la CI puede tirarlos si el worker cambia de forma: verificar
  // con `wrangler secret list` si /api/publicar responde 503.
  //
  // (El rail anterior de R2 vive en la historia de git de src/worker.js.)
  //
  // Mismo nombre que el Worker ya desplegado en la cuenta (asistente-manuales-jarvis
  // .disenocorptpc.workers.dev) — si difiere, un deploy crearía OTRO worker.
  "name": "asistente-manuales-jarvis",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-05",

  "assets": {
    "directory": "./public",
    // 404 normal para rutas que no existen. NO es una SPA: con
    // "single-page-application" cualquier ruta mala devolvería el index
    // con status 200 y los errores se volverían invisibles.
    "not_found_handling": "none"
  },

  "observability": {
    // Logs desde el prototipo: cuántos escanean, qué piezas abren,
    // dónde abandonan. Es el argumento presupuestal de la fase 2.
    "enabled": true
  }
}
