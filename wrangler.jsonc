{
  // Worker del VISOR: assets estáticos. El contenido publicado (GLBs +
  // catálogo) vive en OTRO worker (jarvis-modelos, repo JARVIS-Modelos) —
  // publicar una pieza no toca este repo.
  //
  // ESTACIONADO: src/worker.js trae el rail completo de publicación a R2
  // (PUT /api/publicar + GET /modelos/ con candado de 9 GB). Se decidió no
  // usarlo aún porque R2 exige tarjeta; el día que el repo de modelos pese
  // demasiado, se activa R2 en el dashboard, se crea el bucket
  // jarvis-modelos-r2 y se restaura aquí: "main": "src/worker.js" +
  // r2_buckets [{binding: MODELOS, bucket_name: ...}]. El secret
  // PUBLICAR_TOKEN ya está montado en el worker.
  //
  // Mismo nombre que el Worker ya desplegado en la cuenta (asistente-manuales-jarvis
  // .disenocorptpc.workers.dev) — si difiere, un deploy crearía OTRO worker.
  "name": "asistente-manuales-jarvis",
  "compatibility_date": "2026-08-05",

  "assets": {
    "directory": "./public",
    // 404 normal para rutas que no existen. NO es una SPA: con
    // "single-page-application" cualquier ruta mala devolvería el index
    // con status 200 y los errores se volverían invisibles.
    "not_found_handling": "none"
  },

  "observability": {
    // Logs desde el prototipo: cuántos escanean, qué piezas abren,
    // dónde abandonan. Es el argumento presupuestal de la fase 2.
    "enabled": true
  }
}
